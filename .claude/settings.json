{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/Work/web",
      "~/Work/opencloud"
    ],
    "allow": [
      "Edit(./**)",
      "Write(./**)",
      "Read(./**)",
      "Read(~/Work/web/**)",
      "Read(~/Work/opencloud/**)",
      "Bash(node *)",
      "Bash(node:*)",
      "Bash(RUN_DIR=* node *)",
      "Bash(HEADED=* node *)",
      "Bash(npm run *)",
      "Bash(npm run:*)",
      "Bash(npx playwright *)",
      "Bash(npx playwright:*)",
      "Bash(curl *)",
      "Bash(curl:*)",
      "Bash(cd *)",
      "Bash(cd:*)",
      "Bash(export *)",
      "Bash(export:*)",
      "Bash(mkdir *)",
      "Bash(mkdir:*)",
      "Bash(ls *)",
      "Bash(ls:*)",
      "Bash(cat *)",
      "Bash(cat:*)",
      "Bash(head *)",
      "Bash(head:*)",
      "Bash(tail *)",
      "Bash(tail:*)",
      "Bash(wc *)",
      "Bash(wc:*)",
      "Bash(grep *)",
      "Bash(grep:*)",
      "Bash(rg *)",
      "Bash(rg:*)",
      "Bash(find *)",
      "Bash(find:*)",
      "Bash(jq *)",
      "Bash(jq:*)",
      "Bash(date *)",
      "Bash(date:*)",
      "Bash(sleep *)",
      "Bash(sleep:*)",
      "Bash(echo *)",
      "Bash(echo:*)",
      "Bash(cp *)",
      "Bash(cp:*)",
      "Bash(mv *)",
      "Bash(mv:*)",
      "Bash(python3 *)",
      "Bash(python3:*)",
      "Bash(gh release view *)",
      "Bash(gh release view:*)",
      "Bash(gh issue list *)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view *)",
      "Bash(gh issue view:*)",
      "Bash(gh search issues *)",
      "Bash(gh search issues:*)",
      "Bash(gh pr view *)",
      "Bash(gh pr view:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.opencloud.eu)",
      "Bash(pnpm *)",
      "Bash(pnpm:*)",
      "Bash(git status *)",
      "Bash(git status:*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff:*)",
      "Bash(git log *)",
      "Bash(git log:*)",
      "Bash(git add exploratory/*)",
      "Bash(git commit *)",
      "Bash(git commit:*)",
      "Bash(git checkout -b exploratory/*)",
      "Bash(git switch *)",
      "Bash(git switch:*)",
      "Bash(git branch *)",
      "Bash(git branch:*)",
      "Bash(git fetch *)",
      "Bash(git fetch:*)",
      "Bash(gh release list *)",
      "Bash(gh release list:*)",
      "Bash(node releases/*)",
      "Bash(cd exploratory && node:*)",
      "Bash(cd exploratory && node *)",
      "Bash(pnpm run:*)",
      "Bash(gh pr diff *)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list *)",
      "Bash(gh pr list:*)"
    ],
    "deny": [
      "Bash(gh issue create *)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment *)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create *)",
      "Bash(gh pr create:*)",
      "Bash(gh api -X *)",
      "Bash(gh api -X:*)",
      "Bash(gh api --method *)",
      "Bash(gh api --method:*)",
      "Bash(git push *)",
      "Bash(git push:*)",
      "Bash(rm -rf *)",
      "Bash(rm -rf:*)",
      "Edit(~/Work/web/**)",
      "Edit(~/Work/opencloud/**)",
      "Read(./exploratory/.env)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
