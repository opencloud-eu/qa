# Test instance for the release under test (NOT production)
OC_URL=https://cloud.opencloud.test
OC_ADMIN_USER=CHANGE_ME
OC_ADMIN_PASSWORD=CHANGE_ME
# Demo users: https://docs.opencloud.eu/docs/admin/resources/demo-user
OC_DEMO_PASSWORD=CHANGE_ME
# dennis=Admin, margaret=Space Admin, alan/lynn/mary=User

# Upgrade tests only: your opencloud-compose checkout (it is not changed, the test uses own worktrees and volumes)
OC_COMPOSE_DIR=/Users/<you>/Work/opencloud/opencloud-compose
